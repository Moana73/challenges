{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "challenges",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-21",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // SPAモードでは画面遷移（navigate）リクエストがWorkerより先にindex.htmlで返されるため、
    // 認証とAPIは必ずWorkerを通す（これが無いと /auth/google がログイン画面を返すだけになる）
    "run_worker_first": ["/auth/*", "/api/*"]
  },
  // GOOGLE_CLIENT_ID / ALLOWED_EMAILS はダッシュボードで設定（Publicリポジトリのため）。
  // Git連携デプロイでそれらが消えないよう保持する
  "keep_vars": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "challenges",
      "database_id": "1c8d30c3-1cd7-4382-9318-9813acde638f"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "observability": {
    "enabled": true
  }
}
